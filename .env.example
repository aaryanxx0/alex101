# ===================================================================
# Alex101 dashboard (Next.js) + persistent bot worker configuration
# ===================================================================

# ---- Dashboard auth ----
# A random string ≥ 32 chars used to sign the session cookie.
JWT_SIGNING_SECRET=please-change-me-to-a-32-character-random-string
# Plain-text password users type on /login (only used if DASHBOARD_PASSWORD_HASH is empty).
DASHBOARD_PASSWORD=alex101
# Optional: store a sha256 hash instead of plain text (preferred for production).
DASHBOARD_PASSWORD_HASH=

# ---- Bot worker bridge ----
# URL of the persistent bot-worker (e.g. https://alex101-bot.example.com).
BOT_WORKER_URL=http://localhost:4000
# Shared secret used to call /auth/token and /snapshot. MUST match the worker's BOT_WORKER_SECRET.
BOT_WORKER_SECRET=please-change-me-match-the-worker
# Allowed browser origin for WebSocket (e.g. https://alex101.vercel.app).
DASHBOARD_ORIGIN=http://localhost:3000

# ---- Bot worker configuration (consumed by apps/bot-worker) ----
# Port the worker HTTP/WebSocket listens on.
BOT_WORKER_PORT=4000
# Port the prismarine-viewer HTTP server listens on.
BOT_WORKER_VIEWER_PORT=4001
# Where the worker binds (use 0.0.0.0 for Docker/Railway/Render).
BOT_WORKER_HOST=0.0.0.0
# Shared secret to mint WebSocket tokens. Must match BOT_WORKER_SECRET in the dashboard.
BOT_WORKER_SECRET=please-change-me-match-the-dashboard
# Where to persist non-secret settings (volume-mounted in Docker).
BOT_WORKER_CONFIG=/data/settings.json

# Optional: skip auto-connect on worker boot (1 = connect automatically).
AUTO_CONNECT=1

# ---- Default Minecraft target ----
DEFAULT_MC_HOST=mc.238458.xyz
DEFAULT_MC_PORT=25565
DEFAULT_MC_USERNAME=Alex101
DEFAULT_MC_VERSION=1.21.11
DEFAULT_MC_AUTH=offline
VIEW_DISTANCE=6