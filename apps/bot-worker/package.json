  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "@types/compression": "^1.7.5"
